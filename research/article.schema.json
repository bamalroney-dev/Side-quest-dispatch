{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collected research article",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "title", "canonical_url", "published_at", "summary", "collection_method"],
  "properties": {
    "source": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "canonical_url": {"type": "string", "pattern": "^https://", "format": "source-url"},
    "published_at": {"type": ["string", "null"], "format": "utc-timestamp"},
    "summary": {"type": "string", "maxLength": 500},
    "collection_method": {"enum": ["feedburner", "original_rss", "website", "rss", "store_api"]},
    "review_status": {"const": "needs_verification"},
    "offer_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "ends_at", "market"],
      "properties": {
        "starts_at": {"type": "string", "format": "utc-timestamp"},
        "ends_at": {"type": "string", "format": "utc-timestamp"},
        "market": {"const": "US"}
      }
    }
  }
}
